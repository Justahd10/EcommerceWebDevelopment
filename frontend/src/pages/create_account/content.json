    "main": {
        "header": {
            "logo_img": {
                "src": "/src/features/auth/assets/online_shop_logo_icon.jpg",
                "alt": "Logo Online Shop"
            },
            "title": {
                "name": "Tech Shop",
                "slogan": "A melhor para o consumidor online"
            },
            "subtitle": {
                "title": "Crie sua conta",
                "desc": "e desbloqueie ofertas exclusivas"
            }
        },

        "form": {
            "fields": [
                {
                    "label": "Email",
                    "field_attrs": {
                        "type": "EmailField"
                    },
                    "input_attrs": {
                        "type": "email",
                        "name": "usr_email"
                    }
                },
                {
                    "label": "Senha",
                    "field_attrs": {
                        "type": "PasswordField"
                    },
                    "toogleableByPageState": true,
                    "input_attrs": {
                        "type": "password",
                        "name": "usr_pass"
                    }
                },
                {
                    "label": "Confirmação de senha",
                    "field_attrs": {
                        "type": "PassConfirmField"
                    },
                    "toogleableByPageState": true,
                    "input_attrs": {
                        "type": "password",
                        "name": "usr_pass_confirm"
                    }
                },
                {
                    "label": "Mantenha-me conectado",
                    "field_attrs": {
                        "type": "RememberField"
                    },
                    "toogleableByPageState": false,
                    "input_attrs": {
                        "type": "checkbox",
                        "name": "remember_me"
                    }
                }
            ],
            "default_values": {
                "usr_email": "",
                "usr_pass": "",
                "usr_pass_confirm": "",
                "remember_me": false
            },
            "fields_errs": {
                "usr_email": "Insira um email válido",
                "usr_pass": "Senha deve ter no mínimo 8 caracteres",
                "usr_pass_confirm": "Senhas não coincidem",
                "remember_me": ""
            },
            "actions": [
                {
                    "act_type": "submit_btn",
                    "params": {
                        "class_name": "primary-form-button",
                        "btn_type": "submit",
                        "label": "CADASTRAR"
                    }
                },
                {
                    "act_type": "nav_link",
                    "params": {
                        "class_name": "secondary-form-button",
                        "label": "LOGIN",
                        "link": "/login"
                    }
                }
            ]
        },
        
        "socialAuth": {
            "btns_attrs": [
                {
                    "label": "Google",
                    "img_url": "/src/features/auth/assets/google_icon.png"
                },
                {
                    "label": "Facebook",
                    "img_url": "/src/features/auth/assets/facebook_icon.png"
                }
            ],
            "label": "ou cadastre-se com"
        }
    }
