{
    "header": {
        "logo_img": {
            "src": "/src/features/auth/assets/online_shop_logo_icon.jpg",
            "alt": "Logo Online Shop"
        },
        "title": {
            "name": "Tech Shop",
            "slogan": "A melhor para o consumidor online"
        },
        "subtitle": {
            "title": "Crie sua conta",
            "desc": "e desbloqueie ofertas exclusivas"
        }
    },

    "form": {
        "fields": [
            {
                "label": "Email",
                "field_attrs": {
                    "type": "EmailField"
                },
                "input_attrs": {
                    "type": "email",
                    "name": "usr_email"
                }
            },
            {
                "label": "Senha",
                "field_attrs": {
                    "type": "PasswordField"
                },
                "input_attrs": {
                    "type": "password",
                    "name": "usr_pass"
                }
            },
            {
                "label": "Confirmação de senha",
                "field_attrs": {
                    "type": "PassConfirmField"
                },
                "input_attrs": {
                    "type": "password",
                    "name": "usr_pass_confirm"
                }
            }
        ],
        "actions": [
            {
                "act_type": "submit_btn",
                "params": {
                    "class_name": "primary-form-button",
                    "btn_type": "submit",
                    "label": "CADASTRAR"
                }
            },
            {
                "act_type": "nav_link",
                "params": {
                    "class_name": "secondary-form-button",
                    "label": "LOGIN",
                    "link": "/login"
                }
            }
        ]
    },
    
    "socialAuth": {
        "btns_attrs": [
            {
                "label": "Google",
                "img_url": "/src/features/auth/assets/google_icon.png"
            },
            {
                "label": "Facebook",
                "img_url": "/src/features/auth/assets/facebook_icon.png"
            }
        ],
        "label": "ou cadastre-se com"
    }
}