{
    "header": {
        "logo_img": {
            "src": "/src/features/auth/assets/online_shop_logo_icon.jpg",
            "alt": "Logo Online Shop"
        },
        "title": {
            "name": "Tech Shop",
            "slogan": "A melhor para o consumidor online"
        },
        "subtitle": {
            "container_style": "",
            "title": "Faça login",
            "desc": "E veja o que a nossa loja tema oferecer"
        }
    },

    "form": {
        "class_name": "",
        "fields": [
            {
                "label": "Email",
                "field_attrs": {
                    "type": "EmailField"
                },
                "toogleableByPageState": false,
                "input_attrs": {
                    "type": "email",
                    "name": "usr_email"
                }
            },
            {
                "label": "Senha",
                "field_attrs": {
                    "type": "PasswordField"
                },
                "toogleableByPageState": true,
                "input_attrs": {
                    "type": "password",
                    "name": "usr_pass"
                }
            },
            {
                "label": "Mantenha-me conectado",
                "field_attrs": {
                    "type": "RememberField"
                },
                "toogleableByPageState": false,
                "input_attrs": {
                    "type": "checkbox",
                    "name": "remember_me"
                }
            }
        ],
        "fields_errs": {
            "usr_email": "Insira um email válido",
            "usr_pass": "Senha deve ter no mínimo 8 caracteres"
        },
        "default_values": {
            "usr_email": "",
            "usr_pass": "",
            "remember_me": false
        },
        "actions": [
            {
                "act_type": "submit_btn",
                "params": {
                    "class_name": "",
                    "btn_type": "submit",
                    "label": "LOGIN"
                }
            },
            {
                "act_type": "nav_link",
                "params": {
                    "class_name": "",
                    "label": "Me cadastrar",
                    "link": "/cadastrar"
                }
            },
            {
                "act_type": "nav_link",
                "params": {
                    "class_name": "",
                    "label": "Esqueci minha senha",
                    "link": "/redefinir-senha"
                }
            }
        ],
        "callback_msgs": {
            "auth_error": "Email ou senha inválidos",
            "connection_err": "Falha ao enviar devido a erro de conexão"
        }
    },
    
    "socialAuth": {
        "btns_attrs": [
            {
                "label": "Google",
                "img_url": "/src/features/auth/assets/google_icon.png"
            },
            {
                "label": "Facebook",
                "img_url": "/src/features/auth/assets/facebook_icon.png"
            }
        ],
        "label": "ou entre com"
    }
}