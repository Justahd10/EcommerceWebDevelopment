{
    "header": {
        "logo_img": {
            "src": "/src/features/auth/assets/online_shop_logo_icon.jpg",
            "alt": "Logo Online Shop"
        },
        "title": {
            "name": "Tech Shop",
            "slogan": "A melhor para o consumidor online"
        },
        "subtitle": {
            "container_style": "",
            "title": "Faça login",
            "desc": "E veja o que a nossa loja tema oferecer"
        }
    },

    "form": {
        "class_name": "",
        "fields": [
            {
                "label": "Email",
                "type": "EmailField",
                "input_attrs": {
                    "type": "email",
                    "name": "usr_email"
                }
            },
            {
                "label": "Senha",
                "type": "PasswordField",
                "input_attrs": {
                    "type": "password",
                    "name": "usr_pass"
                }
            },
            {
                "label": "Mantenha-me conectado",
                "type": "RememberField",
                "input_attrs": {
                    "type": "checkbox",
                    "name": "remember_me"
                }
            }
        ],
        "actions": [
            {
                "act_type": "submit_btn",
                "configs": {
                    "class_name": "",
                    "label": "LOGIN"
                }
            },
            {
                "act_type": "nav_link",
                "configs": {
                    "class_name": "",
                    "label": "Me cadastrar",
                    "link": "/create_account"
                }
            },
            {
                "act_type": "nav_link",
                "configs": {
                    "class_name": "",
                    "label": "Esqueci minha senha",
                    "link": "/reset_password"
                }
            }
        ]
    },
    
    "socialAuth": {
        "btns_attrs": [
            {
                "label": "Google",
                "img_url": "/src/features/auth/assets/google_icon.png"
            },
            {
                "label": "Facebook",
                "img_url": "/src/features/auth/assets/facebook_icon.png"
            }
        ],
        "label": "ou entre com"
    }
}