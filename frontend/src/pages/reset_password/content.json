{
    "email_step": {
        "header": {
            "logo_img": {
                "src": "/src/features/auth/assets/online_shop_logo_icon.jpg",
                "alt": "Logo Online Shop"
            },
            "subtitle": {
                "container_style": "",
                "title": "Redefinição de senha",
                "desc": "Digite o email de sua conta. Enviaremos um código de redefinição de senha"
            }
        },

        "form": {
            "class_name": "",
            "fields": [
                {
                    "label": "Email",
                    "type": "EmailField",
                    "input_attrs": {
                        "type": "email",
                        "name": "usr_email"
                    }
                }
            ],
            "fields_errs": {
                "usr_email": "Insira um email válido"
            },
            "default_values": {
                "usr_email": ""
            },
            "actions": [
                {
                    "act_type": "submit_btn",
                    "configs": {
                        "class_name": "",
                        "label": "ENVIAR"
                    }

                },
                {
                    "act_type": "nav_link",
                    "configs": {
                        "class_name": "",
                        "label": "Fazer login",
                        "link": "/login"
                    }
                }
            ],
            "callback_msgs": {
                "success": "Caso email esteja registrado você receberá uma notificação para redefinição de senha"
            }
        }
},
    
    "code_step": {
        "header": {
            "logo_img": {
                "src": "/src/features/auth/assets/online_shop_logo_icon.jpg",
                "alt": "Logo Online Shop"
            },
            "subtitle": {
                "title": "Redefinição de senha",
                "desc": "Insira o código de redefinição de senha que você recebeu por email e sua nova senha"
            }
        },

        "form": {
            "class_name": "",
            "fields": [
                {
                    "label": "Código",
                    "type": "CodeField",
                    "input_attrs": {
                        "type": "text",
                        "name": "pass_reset_code"
                    }
                },
                {
                    "label": "Nova senha",
                    "type": "PasswordField",
                    "input_attrs": {
                        "type": "password",
                        "name": "usr_pass"
                    }
                },
                {
                   "label": "Confirmação da nova senha",
                    "type": "PassConfirmField",
                    "input_attrs": {
                        "type": "password",
                        "name": "usr_pass_confirm"
                    }
                }
            ],
            "fields_errs": {
                "pass_reset_code": "Código deverá conter 6 dígitos",
                "usr_pass": "Senha deve ter no mínimo 8 caracteres",
                "usr_pass_confirm": "Senhas não coincidem"
            },
            "default_values": {
                "pass_reset_code": "",
                "usr_pass": "",
                "usr_pass_confirm": ""
            },
            "actions": [
                {
                    "act_type": "submit_btn",
                    "configs": {
                        "class_name": "",
                        "label": "Redefinir"
                    }
                }
            ],
            "callback_msgs": {
                "success": "",
                "error": ""
            }
        }
    }
}
